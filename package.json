{
  "name": "sauda",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Учёт товаров, касса и отчёты для розничных магазинов",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0",
    "prepare": "husky",
    "preview": "vite preview",
    "db:start": "supabase start -x realtime,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "tsx scripts/db-types.ts",
    "test": "tsx scripts/test-units.ts && tsx scripts/smoke.ts",
    "test:units": "tsx scripts/test-units.ts",
    "seed": "tsx scripts/seed.ts",
    "dev-user": "tsx scripts/dev-user.ts",
    "import": "tsx scripts/import-catalog.ts",
    "catalog": "tsx scripts/load-catalog.ts",
    "seed:brands": "tsx scripts/seed-brands.ts",
    "seed:geo": "tsx scripts/seed-geo.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.59.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "sharp": "^0.35.5",
    "supabase": "^2.40.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": "eslint --max-warnings 0"
  }
}
