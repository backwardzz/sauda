# Скопируйте в .env.local. Для локальной базы значения выводит `npx supabase status`,
# для облачного проекта — Settings → API в панели Supabase.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Капча на входе и регистрации: ключ сайта Cloudflare Turnstile. Пусто — капчи нет.
# Включать вместе с проверкой на сервере (панель Supabase → Authentication → Attack Protection).
VITE_TURNSTILE_SITE_KEY=
